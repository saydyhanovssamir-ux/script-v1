-- ==================== ЛОГИКА ПРИЗРАКА ====================
local function toggleGhost()
    local char, hrp, hum = getChar()
    if not char or not hrp or not hum then return end

    ghostActive = not ghostActive
    if ghostActive then
        GhostBtn.BackgroundColor3, GhostBtn.TextColor3, GhostBtn.Text = Color3.fromRGB(25, 45, 25), Color3.fromRGB(75, 255, 75), "РЕЖИМ ПРИЗРАКА: АКТИВЕН"
        originalCFrame = hrp.CFrame
        
        -- Создаем физическую невидимую сферу-призрак
        ghostPart = Instance.new("Part")
        ghostPart.Name = "NexusGhostPart"
        ghostPart.Size = Vector3.new(2, 2, 2)
        ghostPart.Shape = Enum.PartType.Ball
        ghostPart.Color = Color3.fromRGB(0, 235, 255)
        ghostPart.Material = Enum.Material.Neon
        ghostPart.Transparency = 0.4 -- Едва заметная неоновая сфера, чтобы ты видел, куда летишь
        ghostPart.CanCollide = false
        ghostPart.Anchored = true
        ghostPart.CFrame = hrp.CFrame
        ghostPart.Parent = workspace
        
        Cam.CameraSubject = ghostPart
    else
        GhostBtn.BackgroundColor3, GhostBtn.TextColor3, GhostBtn.Text = Color3.fromRGB(45, 25, 25), Color3.fromRGB(255, 75, 75), "РЕЖИМ ПРИЗРАКА: ВЫКЛ"
        Cam.CameraSubject = hum
        
        -- Мгновенно переносим реальное тело туда, куда долетел призрак
        if ghostPart and hrp then
            hrp.Velocity = Vector3.zero
            char:PivotTo(ghostPart.CFrame)
        end
        if ghostPart then ghostPart:Destroy() ghostPart = nil end
    end
end

